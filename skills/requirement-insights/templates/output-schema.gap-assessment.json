{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gap Assessment Output",
  "description": "gap-assessment prompt 的扁平输出结构（BUG-171，与 #3 同源：不得用 skill 级聚合 schema 校验子步骤结果）。gap/overlap 条数取决于 feature-extraction 结果，不锁条数。",
  "type": "object",
  "required": ["gap_assessments", "overlap_assessments", "baseline_warning"],
  "properties": {
    "gap_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature_id", "feature", "severity", "impact", "suggestion", "priority"],
        "properties": {
          "feature_id": {"type": "string"},
          "feature": {"type": "string"},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "impact": {"type": "string"},
          "suggestion": {"type": "string"},
          "priority": {"type": "string", "enum": ["high", "medium", "low"]}
        }
      }
    },
    "overlap_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature_id", "feature", "overlap_type", "action"],
        "properties": {
          "feature_id": {"type": "string"},
          "feature": {"type": "string"},
          "overlap_type": {"type": "string", "enum": ["evolution", "redundant"]},
          "note": {"type": "string"},
          "action": {"type": "string", "enum": ["no_action", "merge_needed"]}
        }
      }
    },
    "baseline_warning": {"type": "string"}
  }
}
