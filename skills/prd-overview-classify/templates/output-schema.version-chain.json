{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PRD Version Chain Output",
  "type": "object",
  "required": [
    "chains",
    "dependencies"
  ],
  "properties": {
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chain_name",
          "versions"
        ],
        "properties": {
          "chain_name": {
            "type": "string",
            "description": "Short name for the evolution chain"
          },
          "category": {
            "type": "string",
            "description": "Category that all versions in this chain belong to"
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "version",
                "doc_id",
                "title"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "description": "Version label from the document"
                },
                "doc_id": {
                  "type": "string",
                  "description": "Document identifier from the input list"
                },
                "title": {
                  "type": "string",
                  "description": "Document title"
                }
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_doc_id",
          "to_doc_id",
          "relation"
        ],
        "properties": {
          "from_doc_id": {
            "type": "string"
          },
          "to_doc_id": {
            "type": "string"
          },
          "relation": {
            "type": "string",
            "enum": [
              "references",
              "supplements",
              "compatible_with",
              "resolves",
              "version_successor"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}