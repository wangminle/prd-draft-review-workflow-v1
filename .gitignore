# Runtime data — dynamic, clearable (data/code separation)
# Keep README.md and ui-branding.example.yaml as templates; ignore all other runtime data
runtime/*
!runtime/README.md
!runtime/config/
runtime/config/*
!runtime/config/ui-branding.example.yaml
runtime/config/ui-branding.yaml
runtime/config/ui-branding.scan-report.md
# Runtime backups (runtime.bak.* directories created during migration)
runtime.bak.*/

# Python bytecode & cache
**/__pycache__/
*.py[cod]

# Test cache & coverage
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
coverage.json

# Editor/session plan artifacts
.zcode/

# Static analysis caches
.mypy_cache/
.ruff_cache/

# IDE, editor & OS
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~
.DS_Store

# Agent / assistant local settings (may contain secrets or machine paths)
.claude/settings.local.json
.claude/*.local.json

# Environment & secrets
.env
.env.*
!.env.example
.venv/

# Dependencies are in requirements.txt; empty uv.lock makes LWA skip pip (Issue #1).
uv.lock

# Logs
*.log

# Distribution & build artifacts
dist/
build/
*.egg-info/
*.egg
*.whl

# Database & pid files (fallback outside runtime/)
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.pid

# Editor / merge conflict scratch files
*.bak
*.md_[0-9]*

# Node.js dependencies (npm install output)
node_modules/

# Evaluation directory — POC experiments and P2.D.1 acceptance artifacts stay out of git entirely
eval/

# Design documents (internal, pending sensitive-info review before partial git tracking)
design/
