# 环境变量配置
# 复制此文件为 .env 并填入真实值

# LLM API Keys
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
OPENAI_API_KEY=

# OpenAI-compatible API Base（留空则使用官方 endpoint）
# OPENAI_API_BASE=https://api.openai.com/v1

# Embedding 配置（用于知识库向量检索）
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# JWT Secret（可留空：./start.sh 首次会生成并写入项目根目录本文件；勿使用示例占位值）
# 生成: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# 首次启动创建 admin 时可选：显式指定初始密码（不设则随机生成并写入
# runtime/secrets/admin_initial_password.txt 一次性保密文件，0600，改密后自动删除）
# 内置默认/弱口令默认拒绝；内部部署快速体验可两行同时设置：
#   ADMIN_INITIAL_PASSWORD=admin@2026
#   ALLOW_DEFAULT_ADMIN_PASSWORD=1
# 存量实例若仍使用内置默认口令，须先改密或临时设置 ALLOW_DEFAULT_ADMIN_PASSWORD=1
# ADMIN_INITIAL_PASSWORD=
# ALLOW_DEFAULT_ADMIN_PASSWORD=

# Server Port（默认 17957）
# SERVER_PORT=17957

# Server Host（默认 127.0.0.1，仅回环监听、经反向代理对外暴露；直连部署改为 0.0.0.0）
# SERVER_HOST=127.0.0.1

# 子路径反代部署前缀（如应用挂在 https://host/prd-review/ 下时设为 /prd-review；根路径部署留空）
# 设定后：后端把该前缀注入页面 window.__BASE_PATH__，前端所有 /api、/assets 请求会自动带上。
# 反代层（如 lwa/Caddy）须用 handle_path 剥前缀转发，且别名需同时覆盖 /<别名>/api/* 与 /<别名>/assets/*
# —— 不要只把根路径 / 透传到后端来"兜底"，那样换别名或多应用共享网关时前端数据层会断。
# ROOT_PATH=

# 运行时数据目录（默认 <项目目录>/runtime；数据与代码分离部署时显式指定）
# RUNTIME_ROOT=

# 应用配置文件路径（默认 src/config.yaml）
# CONFIG_PATH=

# Agent 自回调基地址（默认 http://127.0.0.1:<SERVER_PORT>；容器/网络隔离部署时显式指定）
# AGENT_API_BASE=
